public class Rational {
    private int numerator;
    private int denominator;
 
    Rational(int numerator, int denominator) {
        if (denominator == 0) {
            throw new IllegalArgumentException("Denominator can't be zero.");
        }
        this.numerator = numerator;
        this.denominator = denominator;
        simplify();
    }
 
    // copy constructor
    Rational(Rational other) {
        this.numerator = other.numerator;
        this.denominator = other.denominator;
    }
 
    // finds the greatest common divisor -- used to reduce the fraction
    private int gcd(int a, int b) {
        a = Math.abs(a);
        b = Math.abs(b);
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
 
    // reduces the fraction to its simplest form, e.g. 2/4 becomes 1/2
    private void simplify() {
        int divisor = gcd(numerator, denominator);
        if (divisor != 0) {
            numerator = numerator / divisor;
            denominator = denominator / divisor;
        }
        // keep the negative sign on the numerator, not the denominator
        if (denominator < 0) {
            numerator = -numerator;
            denominator = -denominator;
        }
    }
 
    // a/b + c/d = (ad + bc) / bd
    Rational add(Rational other) {
        int newNum = (this.numerator * other.denominator) + (other.numerator * this.denominator);
        int newDen = this.denominator * other.denominator;
        return new Rational(newNum, newDen);
    }
 
    // a/b - c/d = (ad - bc) / bd
    Rational subtract(Rational other) {
        int newNum = (this.numerator * other.denominator) - (other.numerator * this.denominator);
        int newDen = this.denominator * other.denominator;
        return new Rational(newNum, newDen);
    }
 
    // a/b * c/d = ac / bd
    Rational multiply(Rational other) {
        int newNum = this.numerator * other.numerator;
        int newDen = this.denominator * other.denominator;
        return new Rational(newNum, newDen);
    }
 
    public String toString() {
        return numerator + "/" + denominator;
    }
}
 
